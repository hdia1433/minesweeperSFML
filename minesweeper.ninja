# minesweeper project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_clang
  command = clang $cflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C source $in

rule cxx_clang
  command = clang++ $cxxflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C++ source $in

rule rc_clang
  command = windres -i $in -o $out $resflags
  description = Compiling resource $in

rule link_clang
  command = clang++ -o $out $in $links $ldflags
  description = Linking target $out

rule pch_clang
  command = clang++ -x c++-header $cflags -o $out -MD -MF $out.d -c $in
  description = Generating precompiled header $in
  depfile = $out.d

rule copy
  command = cp -f $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: minesweeper_Release

cflags_minesweeper_Release = -arch arm64 -O2 -D"NDEBUG" -Isrc/headers -I/opt/homebrew/include -I/opt/homebrew/include/SFML -Iexternals/imgui-sfml -Iexternals/imgui -std=c++23  -MMD -MP
cxxflags_minesweeper_Release = -arch arm64 -O2 -std=c++23 -D"NDEBUG" -Isrc/headers -I/opt/homebrew/include -I/opt/homebrew/include/SFML -Iexternals/imgui-sfml -Iexternals/imgui -std=c++23  -MMD -MP
ldflags_minesweeper_Release = -arch arm64 -L/opt/homebrew/Cellar/sfml/3.0.1/lib
links_minesweeper_Release = -framework Cocoa -framework CoreFoundation -framework CoreGraphics -framework OpenGL -lsfml-graphics -lsfml-window -lsfml-system
objdir_minesweeper_Release = bin-int/Release
targetdir_minesweeper_Release = bin/Release
target_minesweeper_Release = minesweeper

build bin-int/Release/pch.hpp.gch | bin-int/Release/pch.hpp.gch.d: pch_clang src/headers/pch.hpp
  cflags = $cxxflags_minesweeper_Release
  depfile = bin-int/Release/pch.hpp.gch.d
build bin-int/Release/minesweeper.prebuild: prebuild
  prebuildcommands = sh -c 'mkdir -p bin-int/Debug && cp src/headers/pch.hpp bin-int/Debug/pch.hpp && mkdir -p bin-int/Release && cp src/headers/pch.hpp bin-int/Release/pch.hpp && touch "bin-int/Release/minesweeper.prebuild"'
build bin-int/Release/imgui-SFML.o: cxx_clang externals/imgui-sfml/imgui-SFML.cpp | bin-int/Release/pch.hpp.gch bin-int/Release/minesweeper.prebuild
  cxxflags = $cxxflags_minesweeper_Release -include bin-int/Release/pch.hpp
build bin-int/Release/imgui.o: cxx_clang externals/imgui/imgui.cpp | bin-int/Release/pch.hpp.gch bin-int/Release/minesweeper.prebuild
  cxxflags = $cxxflags_minesweeper_Release -include bin-int/Release/pch.hpp
build bin-int/Release/imgui_demo.o: cxx_clang externals/imgui/imgui_demo.cpp | bin-int/Release/pch.hpp.gch bin-int/Release/minesweeper.prebuild
  cxxflags = $cxxflags_minesweeper_Release -include bin-int/Release/pch.hpp
build bin-int/Release/imgui_draw.o: cxx_clang externals/imgui/imgui_draw.cpp | bin-int/Release/pch.hpp.gch bin-int/Release/minesweeper.prebuild
  cxxflags = $cxxflags_minesweeper_Release -include bin-int/Release/pch.hpp
build bin-int/Release/imgui_tables.o: cxx_clang externals/imgui/imgui_tables.cpp | bin-int/Release/pch.hpp.gch bin-int/Release/minesweeper.prebuild
  cxxflags = $cxxflags_minesweeper_Release -include bin-int/Release/pch.hpp
build bin-int/Release/imgui_widgets.o: cxx_clang externals/imgui/imgui_widgets.cpp | bin-int/Release/pch.hpp.gch bin-int/Release/minesweeper.prebuild
  cxxflags = $cxxflags_minesweeper_Release -include bin-int/Release/pch.hpp
build bin-int/Release/controller.o: cxx_clang src/controller/controller.cpp | bin-int/Release/pch.hpp.gch bin-int/Release/minesweeper.prebuild
  cxxflags = $cxxflags_minesweeper_Release -include bin-int/Release/pch.hpp
build bin-int/Release/main.o: cxx_clang src/controller/main.cpp | bin-int/Release/pch.hpp.gch bin-int/Release/minesweeper.prebuild
  cxxflags = $cxxflags_minesweeper_Release -include bin-int/Release/pch.hpp
build bin-int/Release/pch.o: cxx_clang src/controller/pch.cpp | bin-int/Release/pch.hpp.gch bin-int/Release/minesweeper.prebuild
  cxxflags = $cxxflags_minesweeper_Release -include bin-int/Release/pch.hpp
build bin-int/Release/sfVectorOperators.o: cxx_clang src/helpers/sfVectorOperators.cpp | bin-int/Release/pch.hpp.gch bin-int/Release/minesweeper.prebuild
  cxxflags = $cxxflags_minesweeper_Release -include bin-int/Release/pch.hpp
build bin-int/Release/gameBoard.o: cxx_clang src/model/gameBoard.cpp | bin-int/Release/pch.hpp.gch bin-int/Release/minesweeper.prebuild
  cxxflags = $cxxflags_minesweeper_Release -include bin-int/Release/pch.hpp
build bin-int/Release/mineTile.o: cxx_clang src/model/mineTile.cpp | bin-int/Release/pch.hpp.gch bin-int/Release/minesweeper.prebuild
  cxxflags = $cxxflags_minesweeper_Release -include bin-int/Release/pch.hpp
build bin/Release/minesweeper: link_clang bin-int/Release/imgui-SFML.o bin-int/Release/imgui.o bin-int/Release/imgui_demo.o bin-int/Release/imgui_draw.o bin-int/Release/imgui_tables.o bin-int/Release/imgui_widgets.o bin-int/Release/controller.o bin-int/Release/main.o bin-int/Release/pch.o bin-int/Release/sfVectorOperators.o bin-int/Release/gameBoard.o bin-int/Release/mineTile.o
  ldflags = $ldflags_minesweeper_Release
  links = $links_minesweeper_Release
build bin-int/Release/minesweeper.postbuild: postbuild | bin/Release/minesweeper
  postbuildcommands = sh -c 'mkdir -p bin/Release/minesweeper.app/Contents/MacOS && mkdir -p bin/Release/minesweeper.app/Contents/Resources && cp bin/Release/minesweeper bin/Release/minesweeper.app/Contents/MacOS/minesweeper && cp Info.plist bin/Release/minesweeper.app/Contents/Info.plist && mkdir -p bin/Release/minesweeper.app/Contents/Frameworks && cp /opt/homebrew/Cellar/sfml/3.0.1/lib/libsfml-graphics.3.0.1.dylib bin/Release/minesweeper.app/Contents/Frameworks/ && cp /opt/homebrew/Cellar/sfml/3.0.1/lib/libsfml-window.3.0.1.dylib bin/Release/minesweeper.app/Contents/Frameworks/ && cp /opt/homebrew/Cellar/sfml/3.0.1/lib/libsfml-system.3.0.1.dylib bin/Release/minesweeper.app/Contents/Frameworks/ && touch "bin-int/Release/minesweeper.postbuild"'

